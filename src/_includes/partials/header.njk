<header class="site-header">
<div class="wrap site-header__inner">
<div class="brand-row"><a class="brand" href="/" aria-label="{{ site.tradingName }}, home">{{ ui.logo("tertiary", draw=true) }}</a><span class="brand__est" aria-hidden="true">Est. {{ site.established }}</span></div>
<nav class="nav" aria-label="Main">
<ul role="list">
{%- for item in nav.main %}<li><a class="link-draw" href="{{ item.url }}"{% if page.url and page.url.startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>{% endfor -%}
</ul>
</nav>
<div class="site-header__actions">
{{ ui.button("Book now", book=true, size="sm", arrow=false, sheen=true, cls="site-header__book") }}
<a class="menu-btn" href="#footer-nav" data-menu-fallback>{{ ui.icon("menu") }}<span>Menu</span></a>
<button class="menu-btn" type="button" data-menu-open aria-controls="menu" aria-expanded="false" aria-haspopup="dialog" hidden>{{ ui.icon("menu") }}<span>Menu</span></button>
</div>
</div>
{%- if progress %}
<div class="progress" data-progress aria-hidden="true"></div>{% endif %}
</header>
