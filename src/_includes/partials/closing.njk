<section class="closing" aria-label="Book your visit">
{{ ui.logo("icon", cls="watermark") }}
<div class="wrap">
<p class="closing__line" data-reveal>See you soon.</p>
<div class="btn-row" data-reveal style="--d:120ms">{{ ui.button("Book now", book=true) }}</div>
<p class="closing__sub" data-reveal style="--d:220ms">Or call <a class="link" href="tel:{{ site.phone.tel }}">{{ site.phone.display }}</a></p>
</div>
</section>
