{%- import "ui.njk" as ui with context -%}
<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
{%- set docTitle = metaTitle or title -%}
{%- set docDescription = metaDescription or description %}
<title>{% if docTitle and docTitle != site.tradingName %}{{ docTitle }} | {% endif %}{{ site.tradingName }}</title>
{%- if docDescription %}
<meta name="description" content="{{ docDescription }}">{% endif %}
{%- if noindex %}
<meta name="robots" content="noindex, nofollow">{% else %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:locale" content="en_GB">
<meta property="og:site_name" content="{{ site.tradingName }}">
<meta property="og:title" content="{{ docTitle }}{% if docTitle and docTitle != site.tradingName %} | {{ site.tradingName }}{% endif %}">
{%- if docDescription %}
<meta property="og:description" content="{{ docDescription }}">{% endif %}
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/assets/img/share/{{ page.url | shareSlug }}.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ site.tradingName }}{% if docTitle and docTitle != site.tradingName %}: {{ docTitle }}{% endif %}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ docTitle }}{% if docTitle and docTitle != site.tradingName %} | {{ site.tradingName }}{% endif %}">
{%- if docDescription %}
<meta name="twitter:description" content="{{ docDescription }}">{% endif %}
<meta name="twitter:image" content="{{ site.url }}/assets/img/share/{{ page.url | shareSlug }}.jpg">{% endif %}
<meta name="theme-color" content="{{ '#3B302A' if hero else '#F6F1EA' }}"{% if hero %} data-hero-theme{% endif %}>
<link rel="preload" href="/assets/fonts/jost-latin-300-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/site.css?v={{ assetVersion }}">
<script>(function(h){h.classList.add("js");try{if(sessionStorage.getItem("ub-logo"))h.classList.add("logo-seen")}catch(e){}})(document.documentElement)</script>
<script src="/assets/js/site.js?v={{ assetVersion }}" defer></script>
<script type="speculationrules">{"prefetch":[{"where":{"and":[{"href_matches":"/*"},{"not":{"selector_matches":"[data-book]"}}]},"eagerness":"moderate"}]}</script>
{%- set ld = "" | jsonld %}{% if ld %}
{{ ld | safe }}{% endif %}
{%- if env.production %}
<script defer data-domain="{{ site.domain }}" src="https://plausible.io/js/script.js"></script>
<!-- Meta Pixel Code -->
<script>
!function(f,b,e,v,n,t,s)
{if(f.fbq)return;n=f.fbq=function(){n.callMethod?
n.callMethod.apply(n,arguments):n.queue.push(arguments)};
if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
n.queue=[];t=b.createElement(e);t.async=!0;
t.src=v;s=b.getElementsByTagName(e)[0];
s.parentNode.insertBefore(t,s)}(window, document,'script',
'https://connect.facebook.net/en_US/fbevents.js');
fbq('init', '{{ site.metaPixelId }}');
fbq('track', 'PageView');
</script>
<!-- End Meta Pixel Code -->{% endif %}
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/assets/img/brand/icons/urban-beauty-favicon-32.png" sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href="/assets/img/brand/icons/urban-beauty-apple-touch-icon-180.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="apple-mobile-web-app-title" content="Urban Beauty">
<meta name="application-name" content="Urban Beauty">
</head>
<body class="{% if hero %}has-hero{% endif %}{% if bodyClass %} {{ bodyClass }}{% endif %}">
{%- if env.production %}
<noscript><img height="1" width="1" style="display:none" alt="" src="https://www.facebook.com/tr?id={{ site.metaPixelId }}&amp;ev=PageView&amp;noscript=1"></noscript>{% endif %}
<div id="top" tabindex="-1"></div>
<a class="skip-link" href="#main">Skip to content</a>
{% include "partials/header.njk" %}
<main id="main" tabindex="-1">
<div class="print-only print-brand">{{ ui.logo("tertiary", label=site.tradingName) }}<span>{{ site.phone.display }} · {{ site.address.oneLine }}</span></div>
{{ content | safe }}
{% if closing !== false %}{% include "partials/closing.njk" %}{% endif %}
</main>
{% include "partials/bookbar.njk" %}
{% include "partials/footer.njk" %}
{% include "partials/menu.njk" %}
<script type="application/json" id="site-data">{"booking":{{ {url: site.booking.url, mode: site.booking.mode, phones: site.booking.overlayOnPhones, subdomain: site.booking.phorestSubdomain, script: site.booking.widgetScript} | json | safe }},"timezone":{{ site.hours.timezone | json | safe }},"hours":{{ site.hours.days | json | safe }}}</script>
</body>
</html>
