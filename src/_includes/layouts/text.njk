---
layout: layouts/base.njk
progress: true
---
{#- Simple text page (policies, booking terms). Words: src/content/<folder>/<slug>.md, URL /<slug>/.
    Body: Markdown with ## headings (CONTENT_GUIDE.md). Prints cleanly (base print styles). -#}
{%- import "ui.njk" as ui with context -%}
<header class="page-head page-head--text">
<div class="wrap wrap--narrow page-head__text">
<p class="eyebrow">{{ eyebrow or "The Urban Beauty Salon" }}</p>
<h1 style="--d:80ms">{{ title | amp | safe }}</h1>
{%- if lead %}
<p class="lead" style="--d:160ms">{{ lead | todo | safe }}</p>{% endif %}
{%- if updated %}
<p class="small soft" style="--d:200ms">Last updated <time datetime="{{ updated }}">{{ updated | dateLong }}</time></p>{% endif %}
</div>
</header>
<div class="section section--tight">
<div class="wrap wrap--narrow prose">
{{ content | markTodos | safe }}
</div>
</div>
