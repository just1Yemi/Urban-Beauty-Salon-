---
layout: layouts/base.njk
progress: true
---
{#- Treatment page. Words: src/content/<section>/<slug>.md (schema: CONTENT_GUIDE.md).
    Prices come from services.json through the offer filter: public prices only,
    "Free consultation" for prescription services (never a price). -#}
{%- import "ui.njk" as ui with context -%}
{%- set sec = section | sectionInfo -%}
{%- set info = (slug or page.fileSlug) | pageInfo -%}
{%- set o = services | offer -%}
{%- set who = practitioner | practitioner if practitioner else null -%}
{%- set parts = content | sectionsOf -%}
{%- set isTodo = r/^\s*\[\[TODO/ -%}
{%- if o.from %}{% set priceFact = { icon: "tag", label: "Price", price: o.from } %}
{%- else %}{% set priceFact = { icon: "tag", label: "Price", value: ("Free consultation" if o.consultation else ("Price on consultation" if o.heldBack else "[[TODO: price]]")) } %}{% endif -%}
{#- Consultation-only pages (every service is prescription): no results or downtime facts, "Consultations" in place of
    "Prices and times", no review prompts about the treatment, and Book buttons go to the contact form while
    site.booking.consultationVia is "contact" (Phorest still lists the services under their old names). -#}
{%- set priceHeading = "Consultations" if o.consultation else "Prices and times" -%}
{%- set bookHref = "/contact/" if (o.consultation and site.booking.consultationVia == "contact") else "" -%}
{%- set factItems = [{ icon: "clock", label: "Duration", value: (facts.duration or (o | minsRange) or "[[TODO: duration]]") }] -%}
{%- if facts.format %}{% set _ = factItems.push({ icon: "user", label: "Format", value: facts.format }) %}{% endif -%}
{%- if facts.resultsLast %}{% set _ = factItems.push({ icon: "calendar", label: "Results last", value: facts.resultsLast }) %}{% endif -%}
{%- if facts.downtime %}{% set _ = factItems.push({ icon: "moon", label: "Downtime", value: facts.downtime }) %}{% endif -%}
{%- set _ = factItems.push(priceFact) -%}
{%- set tocItems = [] -%}
{%- for s in parts %}{% if s.id %}{% set _ = tocItems.push({ id: s.id, label: s.label }) %}{% endif %}{% endfor -%}
{%- set _ = tocItems.push({ id: "prices", label: priceHeading }) -%}
{%- if faqs and faqs.length %}{% set _ = tocItems.push({ id: "questions", label: "Questions" }) %}{% endif -%}

<header class="page-head">
<div class="wrap page-head__grid">
<div class="page-head__text">
{%- if eyebrow %}
<p class="eyebrow">{{ eyebrow }}</p>
{%- else %}
<p class="eyebrow"><a class="link-draw" href="{{ sec.url }}">{{ sec.label }}</a>{% if info %} · {{ (info.index + 1) | pad2 }}{% endif %}</p>
{%- endif %}
<h1 style="--d:80ms">{{ title | amp | safe }}</h1>
<p class="lead" style="--d:160ms">{{ lead | todo | safe }}</p>
{{ ui.facts(factItems, reveal=false) }}
<div class="btn-row" style="--d:240ms">{% if bookHref %}{{ ui.button(bookLabel, href=bookHref) }}{% else %}{{ ui.button(bookLabel, book=true) }}{% endif %}{{ ui.more(priceHeading, "#prices") }}</div>
</div>
<div class="page-head__media" style="--d:120ms">
{%- if isTodo.test(heroPhoto) %}{{ ui.placeholder(heroPhoto, ratio="45") }}
{%- else %}<div class="frame">{{ ui.picture(heroPhoto, sizes="(min-width: 64em) 36vw, (min-width: 40em) 90vw, 100vw", ratio="45", priority=true) }}</div>{% endif %}
</div>
</div>
</header>

<div class="section section--tight treatment">
<div class="wrap treatment__layout">
{{ ui.toc(tocItems) }}
<div class="treatment__body">
{%- for s in parts %}
{%- if s.id %}
<section class="treatment__section" aria-labelledby="{{ s.id }}" data-reveal>
<h2 class="h3" id="{{ s.id }}">{{ s.label }}</h2>
<div class="prose">{{ s.html | safe }}</div>
{%- if loop.first %}
<div class="treatment__person">{{ ui.person(who.name if who else (practitioner if isTodo.test(practitioner) else "[[TODO: practitioner name]]"), who.role if who else "[[TODO: role, training and registration]]", who.photo if who else "", who.text if who else "") }}</div>
{%- endif %}
</section>
{%- else %}
<div class="prose">{{ s.html | safe }}</div>
{%- endif %}
{%- endfor %}

<section class="treatment__section" aria-labelledby="prices" data-reveal>
<h2 class="h3" id="prices">{{ priceHeading }}</h2>
{{ ui.pricelist(o.rows) }}
<div class="btn-row">{% if bookHref %}{{ ui.button(bookLabel, href=bookHref) }}{% else %}{{ ui.button(bookLabel, book=true) }}{% endif %}</div>
<p class="small soft">Or call <a class="link" href="tel:{{ site.phone.tel }}">{{ site.phone.display }}</a> during opening hours.</p>
</section>

{%- if faqs and faqs.length %}
<section class="treatment__section" aria-labelledby="questions" data-reveal>
<h2 class="h3" id="questions">Questions</h2>
{{ ui.faq(faqs) }}
</section>
{%- endif %}
</div>
</div>
</div>

{%- if pause %}
{%- set pp = photos[pause] %}
<div class="pause{% if pp and pp.ratio == '4:1' %} pause--band{% endif %}" aria-hidden="true">{{ ui.picture(pause, sizes="100vw", alt="") }}</div>
{%- endif %}

{%- set rv = reviews | reviewItems %}
<section class="section section--deep" aria-labelledby="reviews" style="--bg:var(--c-ivory-deep)">
<div class="wrap">
{{ ui.sectionHead("What clients say", eyebrow="Reviews", id="reviews") }}
{{ ui.stat(site.reviews.count, "Five-star reviews on " + site.reviews.source + " since " + site.reviews.since.slice(0, 4)) }}
{%- if rv.length %}
<div class="grid grid--3" style="margin-top:var(--s-6)" data-stagger="110">
{%- for r in rv %}{{ ui.review(r.text, r.name, r.date | monthYear) }}{% endfor %}
</div>
{%- elif o.consultation %}
<p class="small" style="margin-top:var(--s-4)">{{ "[[TODO: one to three general salon reviews (first name and surname initial). None that mention injections, lines and wrinkles results or any medicine]]" | todo | safe }}</p>
{%- else %}
<p class="small" style="margin-top:var(--s-4)">{{ ("[[TODO: one to three Phorest reviews that mention " ~ (title | lower) ~ " (first name and surname initial)]]") | todo | safe }}</p>
{%- endif %}
</div>
</section>

{%- set rel = related | relatedCards(collections.content) %}
{%- if rel.length %}
<section class="section" aria-labelledby="related">
<div class="wrap">
{{ ui.sectionHead("You may also like", eyebrow="Related treatments", id="related") }}
<div class="grid grid--3" data-stagger="110">
{%- for c in rel %}{{ ui.tcard(c.name, c.url, c.photo or ("card for " ~ c.name), detail=c.detail, eyebrow=c.section, text=c.text, from=c.offer.from, mins=c.offer.fromMins, note=("Free consultation" if c.offer.consultation else ("Price on consultation" if c.offer.heldBack else ""))) }}{% endfor %}
</div>
</div>
</section>
{%- endif %}
