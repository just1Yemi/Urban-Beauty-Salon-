{#- =========================================================================
  ui.njk: component macros. Use in any template with
    {% import "ui.njk" as ui with context %}
  Reference: COMPONENTS.md. Never type facts here: they come from src/_data.
========================================================================= -#}

{#- Thin-line icon. name: a key of src/_data/icons.js. label: only when the icon stands alone. -#}
{% macro icon(name, cls="", label="") -%}
<svg class="icon icon--{{ name }}{% if cls %} {{ cls }}{% endif %}" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="butt" stroke-linejoin="miter"{% if label %} role="img" aria-label="{{ label }}"{% else %} aria-hidden="true" focusable="false"{% endif %}>{{ icons[name] | safe }}</svg>
{%- endmacro %}

{#- Logo from the logo pack. variant: primary | secondary | tertiary | icon.
    draw=true traces it in once per visit (ONE per page: the header; the mask id is fixed). -#}
{% macro logo(variant="tertiary", draw=false, cls="", label="") -%}
{%- set L = logos[variant] -%}
<svg class="logo logo--{{ variant }}{% if draw %} logo--draw{% endif %}{% if cls %} {{ cls }}{% endif %}" viewBox="{{ L.viewBox }}" width="{{ L.w }}" height="{{ L.h }}" fill="currentColor"{% if label %} role="img" aria-label="{{ label }}"{% else %} aria-hidden="true" focusable="false"{% endif %}>
{%- if draw %}<mask id="logo-draw-mask" class="logo__mask" maskUnits="userSpaceOnUse" x="0" y="0" width="{{ L.w }}" height="{{ L.h }}"><g fill="none" stroke="#fff" stroke-linecap="butt" stroke-linejoin="round">{{ L.mask | safe }}</g></mask>{% endif -%}
<g class="logo__ink">{{ L.inner | safe }}</g></svg>
{%- endmacro %}

{#- Heritage seal: THE URBAN BEAUTY SALON · EST. 2011 · PENKETH on a circle around the UB icon -#}
{% macro seal(cls="", id="seal-ring") -%}
{%- set L = logos.icon -%}
<svg class="seal{% if cls %} {{ cls }}{% endif %}" viewBox="0 0 200 200" width="200" height="200" role="img" aria-label="{{ site.tradingName }}, established {{ site.established }}, {{ site.address.locality }}">
<defs><path id="{{ id }}" d="M22 100a78 78 0 1 1 156 0a78 78 0 1 1 -156 0"/></defs>
<circle cx="100" cy="100" r="95" fill="none" stroke="currentColor" stroke-width=".6" opacity=".55"/>
<text><textPath href="#{{ id }}" textLength="489" lengthAdjust="spacing">{{ site.tradingName | upper }} · EST. {{ site.established }} · {{ site.address.locality | upper }} ·&#160;</textPath></text>
<g transform="translate(31.2 31.2) scale(.42)" fill="currentColor">{{ L.inner | safe }}</g>
</svg>
{%- endmacro %}

{#- Buttons: two styles only. style: solid | outline. book=true uses the ONE booking setting. -#}
{#- Book buttons always render as the new-tab link (works without JS, and is the fallback):
    the arrow turns to point out, and screen readers hear "(opens in a new tab)". With
    site.booking.mode "overlay", site.js turns them into in-page panel buttons. -#}
{% macro button(label, href="", style="solid", book=false, size="", arrow=true, sheen=false, cls="") -%}
<a class="btn{% if style == 'outline' %} btn--outline{% endif %}{% if size %} btn--{{ size }}{% endif %}{% if cls %} {{ cls }}{% endif %}" href="{{ site.booking.url if book else href }}"{% if book %} data-book target="_blank" rel="noopener"{% endif %}{% if sheen %} data-sheen{% endif %}><span>{{ label }}</span>{% if book %}<span class="visually-hidden" data-book-note> (opens in a new tab)</span>{% endif %}{% if arrow %}{{ icon("arrow", "icon--arrow") }}{% elif book %}{{ icon("arrow", "icon--arrow icon--tab") }}{% endif %}</a>
{%- endmacro %}

{#- Quiet link with arrow: "Discover", "Get directions" -#}
{% macro more(label, href) -%}
<a class="more link-draw" href="{{ href }}">{{ label }}{{ icon("arrow", "icon--arrow") }}</a>
{%- endmacro %}

{#- Eyebrow: AESTHETICS · 01 -#}
{% macro eyebrow(text, num="") -%}
<p class="eyebrow">{{ text }}{% if num %} · {{ num | pad2 }}{% endif %}</p>
{%- endmacro %}

{#- Section heading with optional faint oversized background word -#}
{% macro sectionHead(title, eyebrow="", word="", lead="", level=2, align="left", id="") -%}
<header class="section-head{% if align == 'center' %} section-head--center{% endif %}" data-reveal>
<div class="section-head__title">
{%- if word %}<span class="section-head__word" aria-hidden="true">{{ word }}</span>{% endif %}
{%- if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
<h{{ level }}{% if id %} id="{{ id }}"{% endif %}>{{ title | amp | safe }}</h{{ level }}>
</div>
{%- if lead %}<p class="lead">{{ lead }}</p>{% endif %}
</header>
{%- endmacro %}

{#- Hairline divider. type: line | short | icon (UB circle motif) -#}
{% macro rule(type="line") -%}
{%- if type == "icon" -%}<div class="rule--icon" role="separator">{{ logo("icon") }}</div>
{%- else -%}<hr class="rule{% if type == 'short' %} rule--short{% endif %}">{%- endif -%}
{%- endmacro %}

{#- Responsive photo from src/_data/photos.json: AVIF/WebP, fixed dimensions, blurred preview.
    ratio: 45 | 32 | 11 | wide (or "" for the photo's own). priority=true for the hero only.
    portrait: a second photos.json crop served to portrait screens (art direction), with portraitSizes. -#}
{% macro picture(name, sizes="100vw", ratio="", cls="", loading="lazy", priority=false, alt=false, position="", zoom=0, portrait="", portraitSizes="100vw") -%}
{#- "panel:Label" or "panel-light:Label" draws a branded panel instead of a photo (used where no suitable photo exists yet). -#}
{%- set nm = (name or "") | string -%}
{%- if nm.indexOf("panel") == 0 -%}{{ brandPanel(nm.split(":")[1] or "", ratio, cls, nm.indexOf("panel-light") == 0) }}{%- else -%}
{%- set p = photos[name] -%}
{%- set pp = photos[portrait] if portrait else false -%}
{%- if p -%}
<picture class="pic{% if ratio %} pic--{{ ratio }}{% endif %}{% if cls %} {{ cls }}{% endif %}" style="--lqip:url({{ p.preview }})">
{%- if pp %}{% for fmt in pp.formats %}<source media="(orientation: portrait)" type="image/{{ fmt }}" srcset="{% for w in pp.widths %}{{ pp.path }}-{{ w }}.{{ fmt }} {{ w }}w{% if not loop.last %}, {% endif %}{% endfor %}" sizes="{{ portraitSizes }}" width="{{ pp.width }}" height="{{ pp.height }}">{% endfor %}{% endif -%}
{%- for fmt in p.formats %}<source type="image/{{ fmt }}" srcset="{% for w in p.widths %}{{ p.path }}-{{ w }}.{{ fmt }} {{ w }}w{% if not loop.last %}, {% endif %}{% endfor %}" sizes="{{ sizes }}">{% endfor -%}
<img src="{{ p.path }}-{{ 960 if (p.widths.indexOf(960) > -1) else p.widths[p.widths.length - 1] }}.webp" alt="{{ p.alt if alt === false else alt }}" width="{{ p.width }}" height="{{ p.height }}"{% if priority %} fetchpriority="high"{% else %} loading="{{ loading }}" decoding="async"{% endif %}{% if position or zoom %} style="{% if position %}object-position:{{ position }};{% endif %}{% if zoom %}scale:{{ zoom }};transform-origin:{{ position or '50% 50%' }}{% endif %}"{% endif %}>
</picture>
{%- else -%}{{ placeholder("[[TODO: photo: " ~ name ~ "]]", ratio) }}{%- endif -%}
{%- endif -%}
{%- endmacro %}

{#- Branded panel: Espresso (or Ivory with light=true) with the UB mark, a tracked-caps label, a Champagne hairline and a faint watermark.
    An intentional stand-in for treatment photography, never a fake photo. -#}
{% macro brandPanel(label="", ratio="45", cls="", light=false) -%}
<div class="bpanel{% if light %} bpanel--light{% endif %}{% if ratio %} pic--{{ ratio }}{% endif %}{% if cls %} {{ cls }}{% endif %}" role="img" aria-label="{{ label or site.tradingName }}">
{{ logo("icon", cls="bpanel__watermark") }}
<span class="bpanel__inner">{{ logo("icon", cls="bpanel__icon") }}{% if label %}<span class="bpanel__label">{{ label }}</span>{% endif %}<span class="bpanel__rule" aria-hidden="true"></span><span class="bpanel__sub">{{ site.tradingName }}</span></span>
</div>
{%- endmacro %}

{#- Placeholder for a photo we do not have yet. label should say what is needed. -#}
{% macro placeholder(label, ratio="45", cls="") -%}
<div class="placeholder{% if ratio %} pic--{{ ratio }}{% endif %}{% if cls %} {{ cls }}{% endif %}" role="img" aria-label="Photo to come: {{ label | replace('[[TODO:', '') | replace(']]', '') | trim }}">
{{ logo("icon", cls="placeholder__icon") }}<span class="placeholder__label">{{ label | todo | safe }}</span>
</div>
{%- endmacro %}

{#- Price: "From" in small tracked caps, smaller £, light numerals. Amount from services.json. -#}
{% macro price(amount, from=true, cls="") -%}
<span class="price{% if cls %} {{ cls }}{% endif %}">{% if from %}<span class="price__from">From</span>&nbsp;{% endif %}<span class="price__amt"><span class="price__cur">£</span>{{ amount }}</span></span>
{%- endmacro %}

{#- Luxury menu list with dot leaders. items: [{ name, price, mins }] (use the service filter),
    or { name, note } for rows without a public price (offer filter: "Free consultation", TODO). -#}
{% macro pricelist(items) -%}
<ul class="pricelist" role="list">
{%- for it in items %}{% if it %}<li><span class="pricelist__name">{{ it.name }}{% if it.mins %}<span class="pricelist__dur">{{ it.mins | duration }}</span>{% endif %}</span><span class="pricelist__lead" aria-hidden="true"></span>{% if it.price != null %}{{ price(it.price) }}{% else %}<span class="price price--note"><span class="price__from">{{ it.note | todo | safe }}</span></span>{% endif %}</li>{% endif %}{% endfor -%}
</ul>
{%- endmacro %}

{#- Quick-facts strip. items: [{ icon, label, value }] or { icon, label, price }.
    reveal=false when it sits above the fold (page heads). -#}
{% macro facts(items, reveal=true) -%}
<dl class="facts"{% if reveal %} data-reveal{% endif %}>
{%- for f in items %}<div class="facts__item">{{ icon(f.icon) }}<dt>{{ f.label }}</dt><dd>{% if f.price %}{{ price(f.price) }}{% else %}{{ f.value | replace(r/(\d)–(\d)/g, "$1⁠–⁠$2") | todo | safe }}{% endif %}</dd></div>{% endfor -%}
</dl>
{%- endmacro %}

{#- Treatment card. photo: room photo, detail: second photo shown on hover. from/mins from services.json -#}
{#- note: shown in place of the price ("Free consultation" for prescription services) -#}
{% macro tcard(title, href, photo, detail="", eyebrow="", text="", from=false, mins=false, level=3, note="") -%}
{%- set sizes = "(min-width: 64em) 30vw, (min-width: 40em) 45vw, 100vw" -%}
<article class="tcard" data-reveal>
<div class="tcard__media">{{ picture(photo, sizes=sizes, ratio="45") }}{% if detail %}{{ picture(detail, sizes=sizes, ratio="45", alt="") }}{% endif %}</div>
<div class="tcard__body">
{%- if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
<h{{ level }} class="tcard__title"><a class="tcard__link" href="{{ href }}">{{ title }}</a></h{{ level }}>
{%- if text %}<p class="tcard__text">{{ text | todo | safe }}</p>{% endif %}
{%- if from or mins or note %}<p class="tcard__meta">{% if from %}{{ price(from) }}{% elif note %}<span class="price price--note"><span class="price__from">{{ note }}</span></span>{% endif %}{% if (from or note) and mins %}<span class="sep" aria-hidden="true">·</span>{% endif %}{% if mins %}<span>{{ mins | duration }}</span>{% endif %}</p>{% endif %}
</div>
</article>
{%- endmacro %}

{#- Review card. Reviews: first name and surname initial only; none that mention prescription medicines. -#}
{% macro review(text, name, date="") -%}
<figure class="review" data-reveal>
<svg class="review__mark" viewBox="0 0 48 36" width="48" height="36" aria-hidden="true" focusable="false"><g fill="currentColor"><circle cx="9.5" cy="27.5" r="5.5"/><circle cx="31.5" cy="27.5" r="5.5"/></g><g fill="none" stroke="currentColor" stroke-width="1.4"><path d="M4.2 27.5C4.2 17 8.5 8.5 16.5 3.5"/><path d="M26.2 27.5C26.2 17 30.5 8.5 38.5 3.5"/></g></svg>
<blockquote><p>{{ text | todo | safe }}</p></blockquote>
<figcaption><span class="review__name">{{ name | todo | safe }}</span><span class="review__meta">{% if date %}<span>{{ date | todo | safe }}</span><span aria-hidden="true">·</span>{% endif %}<span>{{ icon("check") }}</span><span>Verified Phorest client</span></span></figcaption>
</figure>
{%- endmacro %}

{#- "Read our Phorest reviews" link (site.reviews.url). Until the link is known: a [[TODO]] in local and preview builds,
    nothing in production. Used wherever there are no review texts yet, so the count never sits above empty cards. -#}
{% macro reviewsLink() -%}
{%- if site.reviews.url %}<p>{{ more("Read our Phorest reviews", site.reviews.url) }}</p>
{%- elif not env.production %}<p class="small">{{ "[[TODO: link to the salon’s public Phorest reviews page, for a “Read our Phorest reviews” link (site.json reviews.url)]]" | todo | safe }}</p>{% endif %}
{%- endmacro %}

{#- Review count that counts up once. Number from site.json reviews. -#}
{% macro stat(number, label) -%}
<p class="stat" data-reveal><span class="stat__num"><span class="visually-hidden">{{ number | thousands }}</span><span aria-hidden="true" data-count="{{ number }}">{{ number | thousands }}</span></span><span class="stat__label">{{ label }}</span></p>
{%- endmacro %}

{#- FAQ accordion. items: [{ q, a }] (a may contain simple HTML) -#}
{% macro faq(items) -%}
<div class="faq">
{%- for it in items %}<details class="faq__item" data-accordion><summary class="faq__q"><span>{{ it.q }}</span>{{ icon("plus") }}</summary><div class="faq__a"><div><p>{{ it.a | todo | safe }}</p></div></div></details>{% endfor -%}
</div>
{%- endmacro %}

{#- Numbered steps (01, 02) linked by a thin vertical line. items: [{ title, text }] -#}
{% macro steps(items, level=3) -%}
<ol class="steps" data-stagger="120">
{%- for s in items %}<li data-reveal><div><h{{ level }} class="h4">{{ s.title }}</h{{ level }}><p>{{ s.text | todo | safe }}</p></div></li>{% endfor -%}
</ol>
{%- endmacro %}

{#- Sticky in-page contents. items: [{ id, label }] -#}
{% macro toc(items, label="On this page") -%}
<nav class="toc" aria-label="{{ label }}" data-toc><p class="eyebrow" aria-hidden="true">{{ label }}</p><ol role="list">
{%- for it in items %}<li><a href="#{{ it.id }}">{{ it.label }}</a></li>{% endfor -%}
</ol></nav>
{%- endmacro %}

{#- "Your practitioner" mini card. photo: a photos.json name, or empty for a placeholder. -#}
{% macro person(name, role, photo="", text="") -%}
<div class="person">
{%- if photo and photos[photo] %}<div class="person__photo">{{ picture(photo, sizes="88px", ratio="45", cls="arch") }}</div>
{%- else %}<div class="person__photo placeholder" role="img" aria-label="Portrait to come">{{ logo("icon", cls="placeholder__icon") }}</div>{% endif %}
<div class="person__body"><p class="eyebrow">Your practitioner</p><p class="person__name">{{ name | todo | safe }}</p><p class="small soft">{{ role | todo | safe }}</p>{% if text %}<p class="small">{{ text | todo | safe }}</p>{% endif %}</div>
</div>
{%- endmacro %}

{#- Opening hours table (today's row highlighted by site.js) -#}
{% macro hours(caption="Opening hours") -%}
<table class="hours" data-hours><caption class="visually-hidden">{{ caption }}</caption><tbody>
{%- for day in site.hours.days %}<tr data-day="{{ day.day }}"><th scope="row">{{ day.label }}</th><td>{{ day | timeRange }}</td></tr>{% endfor -%}
</tbody></table>
{%- endmacro %}

{#- Live "Open now · closes 8pm" (static fallback without JS) -#}
{% macro openStatus() -%}
<span class="status" data-open-status>Open {{ site.hours.days | openDays }}</span>
{%- endmacro %}

{#- Address; site.js turns it into a tap-to-copy button with a quiet "Copied" note -#}
{% macro address() -%}
<address class="addr" data-copy="{{ site.address.oneLine }}">{{ site.address.line1 }}<br>{{ site.address.locality }}, {{ site.address.town }}<br>{{ site.address.postcode }}</address>
{%- endmacro %}

{#- Brand-coloured OpenStreetMap map (scripts/make-map.js writes src/_includes/map.svg, inlined here so street names use the page font).
    The UB circle is the salon marker; the whole map links to Google Maps (no embed, no cookies).
    The credit line under it is required by the OpenStreetMap licence. -#}
{% macro map() -%}
<figure class="map-fig">
<a class="map" href="{{ site.address.oneLine | mapsUrl }}">
{{- "map.svg" | inlineFile | safe -}}
<span class="map__pin" aria-hidden="true">{{ logo("icon") }}</span>
<span class="map__label"><span>{{ site.address.line1 }}, {{ site.address.locality }}<br><span class="soft">{{ site.parking }}</span></span><span class="more">Directions{{ icon("arrow", "icon--arrow") }}</span></span>
<span class="visually-hidden"> (opens Google Maps)</span>
</a>
<figcaption class="map-fig__credit"><a class="link" href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">© OpenStreetMap contributors<span class="visually-hidden"> (opens in a new tab)</span></a></figcaption>
</figure>
{%- endmacro %}

{#- Form field with a floating label. type: text | email | tel | textarea | select | checkbox.
    error: shows the error state (static); message: the error text site.js shows when the field
    is invalid on submit. options: for select ([label, ...]). idp: id prefix, unique per form. -#}
{% macro field(name, label, type="text", required=false, autocomplete="", options=[], hint="", error="", message="", value="", checked=false, idp="f") -%}
{%- set fid = idp ~ "-" ~ name -%}
{%- set describe = (fid ~ "-hint " if hint else "") ~ fid ~ "-err" -%}
{%- set msg = message or ("Please fill in " ~ (label | lower) ~ ".") -%}
{%- set common %} id="{{ fid }}" name="{{ name }}" aria-describedby="{{ describe }}"{% if required %} required{% endif %}{% if error %} aria-invalid="true"{% endif %} data-error="{{ msg }}"{% endset -%}
{%- if type == "checkbox" %}
<div class="field field--check{% if error %} is-invalid{% endif %}">
<label class="check" for="{{ fid }}"><input type="checkbox" value="yes"{{ common | safe }}{% if checked %} checked{% endif %}><span>{{ label | todo | safe }}{% if not required %} <span class="field__opt">(optional)</span>{% endif %}</span></label>
{%- else %}
<div class="field field--{{ type }}{% if error %} is-invalid{% endif %}">
{%- if type == "textarea" %}<textarea class="field__input" rows="5" placeholder=" "{{ common | safe }}>{{ value }}</textarea>
{%- elif type == "select" %}<select class="field__input"{{ common | safe }}><option value=""{% if not value %} selected{% endif %}>Please choose</option>{% for o in options %}<option{% if o == value %} selected{% endif %}>{{ o }}</option>{% endfor %}</select>
{%- else %}<input class="field__input" type="{{ type }}" placeholder=" "{% if autocomplete %} autocomplete="{{ autocomplete }}"{% endif %}{% if type == "email" %} spellcheck="false"{% endif %}{% if value %} value="{{ value }}"{% endif %}{{ common | safe }}>{% endif %}
<label class="field__label" for="{{ fid }}">{{ label }}{% if not required %} <span class="field__opt">(optional)</span>{% endif %}</label>
{%- endif %}
{%- if hint %}<p class="field__hint" id="{{ fid }}-hint">{{ hint | todo | safe }}</p>{% endif %}
<p class="field__error" id="{{ fid }}-err"{% if not error %} hidden{% endif %}>{{ icon("alert") }}<span>{{ error or msg }}</span></p>
</div>
{%- endmacro %}

{#- Contact form block (Netlify Forms, honeypot, calm success panel).
    demo=true: style guide only (no data-netlify, nothing is sent). state: "" | "error" | "success" (static previews).
    Without JS, Netlify returns to action, and :target shows the success panel. -#}
{% macro contactForm(formName="contact", demo=false, state="", idp="contact", action="") -%}
{%- set err = state == "error" -%}
{%- set action = action or (("#" if demo else "/contact/#") ~ idp ~ "-sent") -%}
<div class="form-wrap">
<form class="form" name="{{ formName }}" method="POST" action="{{ action }}"{% if not demo %} data-netlify="true" netlify-honeypot="bot-field"{% else %} data-demo{% endif %} data-form novalidate{% if state == "success" %} hidden{% endif %}>
<input type="hidden" name="form-name" value="{{ formName }}">
<p class="form__trap" aria-hidden="true"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
<p class="form__note small soft">All fields are needed unless marked optional.</p>
<div class="form__row form__row--2">
{{ field("name", "Your name", required=true, autocomplete="name", idp=idp, error=("Please tell us your name." if err else ""), message="Please tell us your name.") }}
{{ field("email", "Email address", type="email", required=true, autocomplete="email", idp=idp, value=("name@example" if err else ""), error=("Please check your email address, for example name@example.com." if err else ""), message="Please enter your email address, for example name@example.com.") }}
</div>
<div class="form__row form__row--2">
{{ field("phone", "Phone", type="tel", autocomplete="tel", idp=idp, hint="We only call if email is not easier.") }}
{{ field("topic", "What is it about?", type="select", idp=idp, options=["A free consultation", "A treatment question", "Booking or changing an appointment", "Something else"]) }}
</div>
{{ field("message", "Your message", type="textarea", required=true, idp=idp, error=("Please write a short message." if err else ""), message="Please write a short message.") }}
{{ field("reply", "You may reply by phone if that is quicker", type="checkbox", idp=idp) }}
<p class="small soft">We use your details only to reply to you. See our <a class="link" href="/privacy/">privacy notice</a>.</p>
<p class="form__fail" data-form-fail hidden role="alert">{{ icon("alert") }}<span>Sorry, your message did not send. Please try again, or call <a class="link" href="tel:{{ site.phone.tel }}">{{ site.phone.display }}</a>.</span></p>
<div><button class="btn" type="submit"><span>Send message</span>{{ icon("arrow", "icon--arrow") }}</button></div>
</form>
<div class="form-success{% if state == 'success' %} is-shown{% endif %}" id="{{ idp }}-sent"{% if not state %} data-form-success{% endif %} role="status" tabindex="-1">
<span class="form-success__icon">{{ icon("check") }}</span>
<p class="h3">Thank you</p>
<p>Your message is on its way to the salon. We usually reply within an hour during opening hours.</p>
<p class="small soft">To book straight away, use any Book now button or call <a class="link" href="tel:{{ site.phone.tel }}">{{ site.phone.display }}</a>.</p>
</div>
</div>
{%- endmacro %}

{#- Practitioner card (About page). p = an entry from practitioners.json, or {} for a placeholder card.
    Fields: name, role, photo (photos.json name), registration { body, number, url }, training, insurance,
    treatments (performed or prescribed). Anything missing shows a [[TODO]]; never invent a name or a registration. -#}
{% macro pcard(p={}) -%}
{%- set reg = p.registration or {} -%}
<article class="pcard">
{%- if p.photo and photos[p.photo] %}<div class="pcard__photo">{{ picture(p.photo, sizes="112px", ratio="45", cls="arch") }}</div>
{%- else %}<div class="pcard__photo placeholder" role="img" aria-label="Portrait to come">{{ logo("icon", cls="placeholder__icon") }}</div>{% endif %}
<div>
<h3 class="pcard__name">{{ (p.name or "[[TODO: practitioner name]]") | todo | safe }}</h3>
<p class="small soft">{{ (p.role or "[[TODO: role]]") | todo | safe }}</p>
</div>
<dl class="pcard__facts">
{#- Rows show only when the data exists: beauty therapists have no professional register or separate indemnity entry. -#}
{%- if reg.number %}<div><dt>Registration</dt><dd>{{ reg.body | todo | safe }} {{ reg.number }}{% if reg.url %} · <a class="link" href="{{ reg.url }}" target="_blank" rel="noopener">Check the register<span class="visually-hidden"> (opens in a new tab)</span></a>{% endif %}</dd></div>{% endif %}
{%- if p.experience %}<div><dt>Experience</dt><dd>{{ p.experience }}</dd></div>{% endif %}
{%- if p.training %}<div><dt>Training</dt><dd>{{ p.training | todo | safe }}</dd></div>{% endif %}
{%- if p.insurance %}<div><dt>Insurance</dt><dd>{{ p.insurance | todo | safe }}</dd></div>{% endif %}
{%- if p.treatments %}<div><dt>Treatments</dt><dd>{{ p.treatments | todo | safe }}</dd></div>{% endif %}
</dl>
</article>
{%- endmacro %}

{#- Callout: a quiet boxed note. kind "alert" (default icon) or any icon name; title optional; body is HTML (pass through safe). -#}
{% macro callout(title="", body="", ico="alert", cls="") -%}
<aside class="callout{% if cls %} {{ cls }}{% endif %}"{% if title %} aria-label="{{ title }}"{% endif %}>{{ icon(ico) }}<div class="callout__body">{% if title %}<p class="callout__title">{{ title }}</p>{% endif %}{{ body | safe }}</div></aside>
{%- endmacro %}
