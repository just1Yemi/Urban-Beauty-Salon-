{{ ui.eyebrow("Private · not indexed") }}
<h2 id="sg-intro">The design system</h2>
<p class="lead">Every token and component, in use with the salon’s own photographs. Resize the window, or open this page on a phone: the layout is checked at 360, 768 and 1440 pixels wide.</p>
<p class="sg-note">Sample copy on this page is for layout only. Final words are written in later stages and reviewed by the practitioners. Yellow marks <span class="todo">[[TODO]]</span> show facts we still need.</p>
<ul class="sg-nav" role="list">
<li><a class="link" href="#colour">Colour</a></li><li><a class="link" href="#type">Type</a></li><li><a class="link" href="#space">Space, shape, motion</a></li><li><a class="link" href="#logo">Logo and seal</a></li><li><a class="link" href="#icons">Icons</a></li><li><a class="link" href="#buttons">Buttons and links</a></li><li><a class="link" href="#headings">Headings and dividers</a></li><li><a class="link" href="#images">Images</a></li><li><a class="link" href="#treatment">Treatment section</a></li><li><a class="link" href="#cards">Cards</a></li><li><a class="link" href="#prices">Prices</a></li><li><a class="link" href="#reviews">Reviews</a></li><li><a class="link" href="#visit">Visit</a></li><li><a class="link" href="#forms">Forms</a></li>
</ul>
</div>
</section>

{#- ===== Colour ===== -#}
<section class="section" aria-labelledby="colour">
<div class="wrap">
{{ ui.sectionHead("Colour", eyebrow="Tokens · 01", id="colour", lead="Ivory backgrounds and Espresso text. Champagne is an accent for hairlines, icons and dark surfaces: never text on Ivory.") }}
<div class="sg-swatches">
{%- set roles = { "espresso": "Text, buttons, footer", "champagne": "Hairlines, icons, hover fill", "ivory": "Page background", "onyx": "Reserved (not for large areas)", "white": "Review cards", "ivory-deep": "Tint: alternate band", "ivory-shade": "Tint: photo placeholders", "text-soft": "Tint: secondary text", "ivory-soft": "Tint: text on Espresso", "espresso-deep": "Tint: deepest Espresso" } %}
{%- for name, hex in palette.tokens %}
<div class="sg-swatch"><div class="sg-swatch__chip" style="background:{{ hex }}"></div><div class="sg-swatch__meta"><strong>{{ name }}</strong><br><span class="tnum">{{ hex }}</span><br><span class="soft">{{ roles[name] }}</span></div></div>
{%- endfor %}
</div>
<h3 class="h4" style="margin-top:var(--s-6)">Contrast of every text pair (WCAG 2.2)</h3>
<div class="sg-scroll" style="margin-top:var(--s-3)" tabindex="0" role="region" aria-label="Contrast table (scrolls sideways on small screens)">
<table class="sg-table">
<thead><tr><th scope="col">Sample</th><th scope="col">Pair</th><th scope="col">Ratio</th><th scope="col">Level</th><th scope="col">Use</th></tr></thead>
<tbody>
{%- for p in palette.pairs %}
<tr><td>{% if p.forbidden %}<span class="soft">Not used</span>{% else %}<span class="sg-sample" style="color:{{ p.fgHex }};background:{{ p.bgHex }}">Aa 12</span>{% endif %}</td><td>{{ p.fg }} on {{ p.bg }}</td><td class="tnum">{{ p.ratio }}:1</td><td>{{ "Not allowed" if p.forbidden else p.level }}</td><td>{{ p.use }}</td></tr>
{%- endfor %}
</tbody>
</table>
</div>
</div>
</section>

{#- ===== Type ===== -#}
<section class="section section--deep" aria-labelledby="type" style="--bg:var(--c-ivory-deep)">
<div class="wrap">
{{ ui.sectionHead("Typography", eyebrow="Tokens · 02", id="type", word="Type", lead="Jost light, uppercase and tracked for headings; Inter for reading. Fluid sizes with clamp(), balanced headings and no single-word last lines.") }}
<div class="stack-l">
<div class="stack-s"><p class="caption">Display · Jost 300 · step 5</p><p class="display" aria-hidden="true">Penketh</p></div>
<div class="stack-s"><p class="caption">Heading 1 · step 4 · tracked 0.12em</p><p class="h1" aria-hidden="true">Lines and wrinkles consultation</p></div>
<div class="stack-s"><p class="caption">Heading 2 · step 3 · tracked 0.16em</p><p class="h2" aria-hidden="true">Your first visit</p></div>
<div class="stack-s"><p class="caption">Heading 3 · step 2 · tracked 0.18em</p><p class="h3" aria-hidden="true">What to expect</p></div>
<div class="stack-s"><p class="caption">Heading 4 · Jost 400</p><p class="h4" aria-hidden="true">Aftercare</p></div>
<div class="stack-s"><p class="caption">Lead · Inter 400 · step 1</p><p class="lead">A calm, unhurried appointment in a salon that has looked after {{ site.address.locality }} since {{ site.established }}.</p></div>
<div class="stack-s"><p class="caption">Body · Inter 400 · step 0 · measure 34em, about 65 characters a line</p><p>Body copy sits in Inter at a comfortable reading size, with generous line spacing and a measure of about sixty-five characters. Times use en dashes, such as 10:00–20:00, quotation marks are curly (“like this”), and prices never break across lines: {{ ui.price(derma.price) }}.</p></div>
<div class="stack-s"><p class="caption">Small and eyebrow labels · wider tracking</p><p class="small soft">Small text for notes and captions.</p>{{ ui.eyebrow("Aesthetics", 1) }}</div>
<div class="stack-s"><p class="caption">Tabular figures for prices, times and phone numbers</p><p class="tnum">{{ site.phone.display }} · 09:00–15:00 · 10:00–20:00</p></div>
<div class="stack-s"><p class="caption">Pull quote with a hanging quotation mark (a print on the salon wall)</p><blockquote><p class="pullquote">“May your lashes be long and your standards be high.”</p></blockquote></div>
<div class="sg-dark on-dark stack-s"><p class="caption" style="color:var(--c-ivory-soft)">Champagne ampersand · on Espresso only</p><p class="h1" aria-hidden="true">{{ "Skin & Beauty" | amp | safe }}</p></div>
</div>
</div>
</section>

{#- ===== Space, shape, motion ===== -#}
<section class="section" aria-labelledby="space">
<div class="wrap">
{{ ui.sectionHead("Space, shape and motion", eyebrow="Tokens · 03", id="space") }}
<div class="grid grid--2" style="--gap:var(--s-6)">
<div>
<h3 class="h4 sg-label">8px spacing scale</h3>
<div class="sg-space">
{%- for s in [["s-1", 8], ["s-2", 16], ["s-3", 24], ["s-4", 32], ["s-5", 48], ["s-6", 64], ["s-7", 96], ["s-8", 128], ["s-9", 160]] %}
<div><span class="tnum">--{{ s[0] }} · {{ s[1] }}</span><span style="width:{{ s[1] }}px;max-width:100%"></span></div>
{%- endfor %}
</div>
<p class="small soft" style="margin-top:var(--s-3)">Sections: 64px tall padding on phones rising to 96–160px on desktop.</p>
</div>
<div>
<h3 class="h4 sg-label">One sharp radius, warm shadows</h3>
<div class="sg-cards">
<div class="sg-card" style="box-shadow:var(--shadow-1)"><strong>--shadow-1</strong><br>Cards, the header once scrolled. Espresso-tinted, never grey.</div>
<div class="sg-card" style="box-shadow:var(--shadow-2)"><strong>--shadow-2</strong><br>Text cards over images, the map pin. Radius 2px everywhere.</div>
</div>
<h3 class="h4 sg-label" style="margin-top:var(--s-5)">Motion</h3>
<table class="sg-table">
<tbody>
<tr><th scope="row">Reveal</th><td>700ms fade and 14px rise, staggered; once</td></tr>
<tr><th scope="row">Image wipe</th><td>1.4s clip-path wipe with a slow settle</td></tr>
<tr><th scope="row">Hover</th><td>380ms Champagne fill, 4px arrow nudge, 3% image zoom</td></tr>
<tr><th scope="row">Logo</th><td>Draws itself in once per visit, about 1.2s</td></tr>
<tr><th scope="row">Pages</th><td>0.4s cross-fade (View Transitions), prefetch on hover</td></tr>
<tr><th scope="row">Reduced motion</th><td>All of the above switch off</td></tr>
</tbody>
</table>
</div>
</div>
</div>
</section>

