<p class="lead" style="--d:160ms">Aesthetics, facials and beauty treatments in {{ site.address.locality }}, {{ site.address.town }}.</p>
<div class="btn-row" style="--d:240ms">{{ ui.button("Book now", book=true) }}{{ ui.button("Explore treatments", href="#cards", style="outline", arrow=false) }}</div>
</div>
</section>

