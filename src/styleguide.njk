<style>
/* Style-guide-only helpers (not shipped to other pages) */
.sg-nav { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; list-style: none; padding: 0; font-size: var(--step--1); }
.sg-block + .sg-block { margin-top: var(--s-7); }
.sg-label { margin-bottom: var(--s-3); }
.sg-swatches { display: grid; gap: var(--s-3); grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr)); }
.sg-swatch { border: 1px solid var(--line-soft); border-radius: var(--radius); overflow: hidden; background: var(--c-white); font-size: var(--step--1); }
.sg-swatch__chip { height: 5.5rem; }
.sg-swatch__meta { padding: .75rem; line-height: 1.5; }
.sg-table { width: 100%; font-size: var(--step--1); font-variant-numeric: tabular-nums; }
.sg-table th, .sg-table td { text-align: left; padding: .6rem .75rem .6rem 0; border-bottom: 1px solid var(--line-soft); vertical-align: top; }
.sg-table th { font-weight: 500; }
.sg-scroll { overflow-x: auto; }
.sg-sample { display: inline-block; padding: .2rem .55rem; border-radius: var(--radius); font-weight: 500; }
.sg-space { display: grid; gap: .5rem; }
.sg-space div { display: grid; grid-template-columns: 7.5rem 1fr; align-items: center; gap: 1rem; font-size: var(--step--1); }
.sg-space span:last-child { height: .5rem; background: var(--c-champagne); }
.sg-cards { display: grid; gap: var(--s-4); grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); }
.sg-card { padding: var(--s-4); background: var(--c-ivory); border-radius: var(--radius); font-size: var(--step--1); }
.sg-icons { display: grid; gap: var(--s-2); grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr)); list-style: none; padding: 0; }
.sg-icons li { display: grid; justify-items: center; gap: .6rem; padding: var(--s-3) .5rem; border: 1px solid var(--line-soft); border-radius: var(--radius); font-size: var(--step--2); letter-spacing: .08em; color: var(--text-soft); }
.sg-icons .icon { width: 1.75rem; height: 1.75rem; color: var(--c-espresso); }
.sg-logos { display: grid; gap: var(--s-4); }
.sg-logo { display: grid; place-items: center; min-height: 11rem; padding: var(--s-5) var(--s-4); border-radius: var(--radius); }
.sg-logo .logo { width: min(100%, 26rem); }
.sg-logo .logo--icon { width: 7rem; }
.sg-logo .seal { width: 10rem; }
@media (min-width: 48em) { .sg-logos { grid-template-columns: repeat(2, minmax(0, 1fr)); } .sg-logo--wide { grid-column: 1 / -1; } }
.sg-dark { padding: var(--s-5) var(--s-4); border-radius: var(--radius); }
.sg-frames { display: grid; gap: var(--s-5) var(--s-4); }
@media (min-width: 40em) { .sg-frames { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (min-width: 64em) { .sg-frames { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
.sg-treat { display: grid; gap: var(--s-6); }
@media (min-width: 64em) { .sg-treat { grid-template-columns: 14rem minmax(0, 1fr); gap: var(--s-7); align-items: start; } }
.sg-treat__body > section + section { margin-top: var(--s-7); }
.sg-accent { display: grid; gap: var(--s-4); align-items: end; }
@media (min-width: 48em) { .sg-accent { grid-template-columns: minmax(0, 1fr) 13rem; } }
.sg-note { padding: var(--s-2) var(--s-3); border-left: 1px solid var(--c-champagne); font-size: var(--step--1); color: var(--text-soft); max-width: 60ch; }
.sg-visit { display: grid; gap: var(--s-6); }
@media (min-width: 64em) { .sg-visit { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>

{#- ===== Sample hero ===== -#}
<section class="hero" aria-labelledby="hero-title">
